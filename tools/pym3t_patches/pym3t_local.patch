diff --git a/setup.py b/setup.py
index 0322bbc..f32e4e1 100644
--- a/setup.py
+++ b/setup.py
@@ -1,4 +1,7 @@
 import os
+import shutil
+import subprocess
+import sys
 from pathlib import Path
 
 from setuptools import setup, Extension
@@ -13,27 +16,54 @@ class BuildExt(build_ext):
         for ext in self.extensions:
             if isinstance(ext, CMakeExtension):
                 self.build_cmake(ext)
-        super().run()
 
     def build_cmake(self, ext):
+        conda_prefix = os.environ.get("CONDA_PREFIX")
+        conda_cmake = None
+        if conda_prefix:
+            candidate = Path(conda_prefix) / "Library" / "bin" / "cmake.exe"
+            if candidate.exists():
+                conda_cmake = str(candidate)
+
+        cmake = conda_cmake or shutil.which("cmake")
+        if cmake is None:
+            raise RuntimeError(
+                "CMake was not found on PATH. Install CMake, then reopen "
+                "PowerShell/VSCode so the PATH update is visible. "
+                "Check with: cmake --version"
+            )
+
         base_dir = Path(__file__).resolve().parent
         os.chdir(base_dir)
-        build_temp = Path(self.build_temp)
+        build_temp = base_dir / "build_pym3t" / ext.name
+        if build_temp.exists():
+            shutil.rmtree(build_temp)
         os.makedirs(build_temp, exist_ok=True)
         ext_dir = Path(self.get_ext_fullpath(ext.name)).absolute()
         os.makedirs(ext_dir.parent, exist_ok=True)
 
         cmake_args = [
             "-DCMAKE_LIBRARY_OUTPUT_DIRECTORY=" + str(ext_dir.parent),
+            "-DCMAKE_LIBRARY_OUTPUT_DIRECTORY_RELEASE=" + str(ext_dir.parent),
+            "-DPython_EXECUTABLE=" + sys.executable,
+            "-DPYTHON_EXECUTABLE=" + sys.executable,
             "-DCMAKE_BUILD_TYPE=Release"
         ]
+        if conda_prefix:
+            cmake_args += [
+                "-DCMAKE_PREFIX_PATH=" + conda_prefix,
+                "-DEigen3_DIR=" + str(Path(conda_prefix) / "Library" / "share" / "eigen3" / "cmake"),
+                "-DGLEW_ROOT=" + str(Path(conda_prefix) / "Library"),
+                "-Dglfw3_DIR=" + str(Path(conda_prefix) / "Library" / "lib" / "cmake" / "glfw3"),
+                "-DOpenCV_DIR=" + str(Path(conda_prefix) / "Library" / "cmake" / "x64" / "vc16" / "lib"),
+            ]
 
-        build_args = ["-j6"]
+        build_args = ["--config", "Release", "--parallel", "6"]
 
         os.chdir(build_temp)
-        self.spawn(["cmake", f"{base_dir}/{ext.name}"] + cmake_args)
+        subprocess.check_call([cmake, str(base_dir / ext.name)] + cmake_args)
         if not self.dry_run:
-            self.spawn(["cmake", "--build", "."] + build_args)
+            subprocess.check_call([cmake, "--build", "."] + build_args)
         os.chdir(base_dir)
 
 setup(
